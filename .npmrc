# Committed project npm config - contains NO secrets.
#
# @fundacja-peryskop/ui (the Peryskop design system) is published on GitHub
# Packages, which requires a token even to install. npm expands ${GITHUB_TOKEN}
# from the environment at install time, so the literal token never touches the
# repo. Every environment that runs `npm install` needs GITHUB_TOKEN set to a
# GitHub token with the `read:packages` scope:
#   - local:   Windows `setx GITHUB_TOKEN "ghp_..."` / macOS, Linux `export GITHUB_TOKEN=ghp_...`
#   - Netlify: Site configuration > Environment variables > GITHUB_TOKEN
# See the design system's docs/PUBLISHING.md ("Installing the package").
@fundacja-peryskop:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# The design system is a universal (web + React Native) Tamagui library. Its
# `react-native` peer would make npm resolve React Native, whose typings require
# @types/react 19 - incompatible with this React 18 web app. Skip strict peer
# resolution so installs match the committed package-lock.json.
legacy-peer-deps=true
