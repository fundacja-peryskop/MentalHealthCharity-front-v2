{
    "semi": true,
    "singleQuote": false,
    "printWidth": 120,
    "trailingComma": "es5",
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
