# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo

# Tamagui compiler cache (generated by @tamagui/vite-plugin)
.tamagui

# Environment files
.env
# Every .env variant, e.g. .env.production or .env.local. Git has no inline
# comments: "pattern  # note" would be one literal pattern that matches nothing.
.env.*

# Allow example env files
!.env.example

# Misc
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.npmrc
# ...except the committed project config, which holds no secrets (token comes from ${GITHUB_TOKEN}).
!/.npmrc
